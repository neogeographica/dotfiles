Host ng.github.com
    HostName github.com
    User git
    PreferredAuthentications publickey
    IdentityFile ~/.ssh/ng_github_rsa.pub

Host ng.gist.github.com
    HostName gist.github.com
    User git
    PreferredAuthentications publickey
    IdentityFile ~/.ssh/ng_github_rsa.pub

Host bd.github.com
    HostName github.com
    User git
    PreferredAuthentications publickey
    IdentityFile ~/.ssh/bluedata_github_rsa.pub

Host bd.gist.github.com
    HostName gist.github.com
    User git
    PreferredAuthentications publickey
    IdentityFile ~/.ssh/bluedata_github_rsa.pub

Host github.com
    HostName github.com
    User git
    PreferredAuthentications publickey
    IdentityFile ~/.ssh/bluedata_github_rsa.pub

Host gist.github.com
    HostName gist.github.com
    User git
    PreferredAuthentications publickey
    IdentityFile ~/.ssh/bluedata_github_rsa.pub

Host *
{{- if eq .chezmoi.os "darwin" }}
    IdentityAgent "~/.bitwarden-ssh-agent.sock"
{{- else }}
    IdentityAgent "~/.var/app/com.bitwarden.desktop/data/.bitwarden-ssh-agent.sock"
{{- end }}
